<div class="container chain-conv-container">
  <%= stylesheet_link_tag 'calculator' %>
  <div class="card">
    <div class="card-header">


      <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
          
          <div class="collapse navbar-collapse" id="navbarNavDropdown">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="#">Home</a>
              </li>
              
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-expanded="false">
                  Шнек
                </a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="#">Сегменти</a></li>
                  <li><a class="dropdown-item" href="#">Цільнотягнута спіраль</a></li>
                  <li><a class="dropdown-item" href="#">Ремонт Шнека</a></li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </nav>

    </div>
    <div class="card-body chain-conv-form">x

      <!-- Обгортка з формами -->
      <div id="screwForms">
        <%= render 'calculators/screw_segment' %>
        <%= render 'calculators/screw_spiral' %>
        <%= render 'calculators/screw_repair' %>
      </div>
    </div>
  </div>
</div>

<script>
// Перемикання між формами
document.addEventListener('DOMContentLoaded', function() {
  const radios = document.querySelectorAll('input[name="screwType"]');
  const segment = document.getElementById('segmentForm');
  const spiral = document.getElementById('spiralForm');
  const repair = document.getElementById('repairForm');
  const header = document.getElementById('screwTypeHeader');
  const options = document.getElementById('screwTypeOptions');

  function showForm(type) {
    // Скидаємо стан
    segment.classList.add('d-none');
    spiral.classList.add('d-none');
    repair.classList.add('d-none');

    if (type === 'segment') segment.classList.remove('d-none');
    if (type === 'spiral') spiral.classList.remove('d-none');
    if (type === 'repair') repair.classList.remove('d-none');
  }

  function updateHeaderBold() {
    const checked = document.querySelector('input[name="screwType"]:checked');
    if (checked) {
      header.classList.add('selected');
    } else {
      header.classList.remove('selected');
    }
  }

  header.addEventListener('click', function() {
    options.classList.toggle('d-none');
  });

  radios.forEach(r => {
    r.addEventListener('change', () => {
      showForm(r.value);
      updateHeaderBold();
    });
  });

  // Початковий стан
  const initial = document.querySelector('input[name="screwType"]:checked');
  showForm(initial ? initial.value : 'segment');
  updateHeaderBold();
});
</script>
<div class="container chain-conv-container" style="margin-top: 20px;">
  <%= stylesheet_link_tag 'calculator' %>
  <div class="card">
    <div class="card-header" style="height: 100px;">


      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          
          <%# <div class="collapse navbar-collapse" id="navbarNavDropdown">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="#">Home</a>
              </li>
              
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-expanded="false">
                  Шнек
                </a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="#" data-target="segment">Сегменти</a></li>
                  <li><a class="dropdown-item" href="#" data-target="spiral">Цільнотягнута спіраль</a></li>
                  <li><a class="dropdown-item" href="#" data-target="repair">Ремонт Шнека</a></li>
                </ul>
              </li>
            </ul>
          </div> %>
        </div>
      </nav>

    </div>
    <div class="card-body chain-conv-form">
 <!-- Обгортка з формами -->
      

      <div>
        <h5 class="mb-3">Ремонт шнека</h5>
        <div class="row">
          <div class="col-6 col-md-3">
            <div class="form-group mb-2">
              <label>D</label>
              <input type="number" class="form-control form-control-sm bg-secondary text-light border-0" placeholder="D">
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="form-group mb-2">
              <label>d</label>
              <input type="number" class="form-control form-control-sm bg-secondary text-light border-0" placeholder="d">
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="form-group mb-2">
              <label>P</label>
              <input type="number" class="form-control form-control-sm bg-secondary text-light border-0" placeholder="P">
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="form-group mb-2">
              <label>S</label>
              <input type="number" class="form-control form-control-sm bg-secondary text-light border-0" placeholder="S">
            </div>
          </div>
        </div>
      </div>



      <!-- Обгортка з формами -->
      <%# <div id="screwForms">
        <%= render 'calculators/screw_segment' %
        <%= render 'calculators/screw_spiral' %
        <%= render 'calculators/screw_repair' %>
      </div> 
    </div>
  </div>
</div>

<script>
// Перемикання між формами
document.addEventListener('DOMContentLoaded', function() {
  const segment = document.getElementById('segmentForm');
  const spiral = document.getElementById('spiralForm');
  const repair = document.getElementById('repairForm');
  const menuItems = document.querySelectorAll('.dropdown-menu .dropdown-item');

  function showForm(type) {
    // Скидаємо стан
    segment.classList.add('d-none');
    spiral.classList.add('d-none');
    repair.classList.add('d-none');

    if (type === 'segment') segment.classList.remove('d-none');
    if (type === 'spiral') spiral.classList.remove('d-none');
    if (type === 'repair') repair.classList.remove('d-none');
  }

  // Перемикання через меню
  menuItems.forEach(item => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      const target = item.getAttribute('data-target');
      if (target) {
        showForm(target);
      }
    });
  });

  // Початковий стан
  showForm('segment');
});
</script>